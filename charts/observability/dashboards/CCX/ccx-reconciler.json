{
  "uid": "ccx-reconciler",
  "title": "CCX / Reconciler",
  "tags": [
    "ccx",
    "reconciler"
  ],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "Datastore reconciler: how far each datastore is from its spec, what the reconciler does about it, and the stores worker that runs it.",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ccx"
      ],
      "asDropdown": true,
      "title": "CCX dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "environment",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "hide": 0,
        "sort": 1,
        "definition": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "datasource": null,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Datastores reconciled",
      "description": "Datastores with a reconcile plan series: non-flat topologies that are not being destroyed. Flat-topology datastores are not reconciled and have no series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Not converged",
      "description": "Datastores whose last reconcile plan has steps to run, i.e. they don't match their spec yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0)) or (count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * 0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Planned steps",
      "description": "Sum of the steps in the last reconcile plan of every datastore. The reconciler runs one step per pass, so this is the work still queued.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(sum(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}))) or (count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * 0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Incomplete plans",
      "description": "Datastores whose last plan stops short of the spec: the planner could not plan every step, or put work off while a host is unhealthy. These won't converge on their own.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}) == 1)) or (count(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * 0)",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Steps executed (range)",
      "description": "Reconcile steps started in the selected range (\"reconcile: execute step\" and the disk-only path for failed datastores), from the state-worker logs.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |~ \"reconcile( disk only)?: execute step\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Reconcile failures (range)",
      "description": "Reconcile passes that ended in an error in the selected range (\"work function failed\" with \"reconcile store\"), from the state-worker logs. Waiting for new nodes, a healthy primary or an unhealthy host is not counted.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |= \"work function failed\" |~ \"reconcile store\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Datastores",
      "collapsed": false,
      "panels": [],
      "datasource": null,
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Datastores not converged (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every datastore that had planned steps or an incomplete plan at some point in the selected range. \"Not converged for\" is the time in the range with work pending (1-minute resolution). Click a row to open its reconciler log lines.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"})) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "((max_over_time(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})[$__range])) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (max_over_time(max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "((count_over_time(((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0) or (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}) > 0))[$__range:1m]) * 60) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (count_over_time(((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0) or (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}) > 0))[$__range:1m]) * 60)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "Value #D",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "kubernetes_namespace": 0,
              "DatastoreName": 1,
              "ClusterType": 2,
              "datastore_uuid": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7
            },
            "renameByName": {
              "kubernetes_namespace": "Environment",
              "DatastoreName": "Datastore",
              "ClusterType": "Type",
              "datastore_uuid": "UUID",
              "Value #A": "Planned steps now",
              "Value #B": "Incomplete now",
              "Value #C": "Max planned steps",
              "Value #D": "Not converged for"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Reconciler log lines for this datastore",
              "url": "/d/ccx-logs/ccx-logs?var-environment=${__data.fields.Environment}&var-container=state-worker&var-level=$__all&var-search=${__data.fields.UUID}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Not converged for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Incomplete now"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "green"
                      },
                      "1": {
                        "text": "yes",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Planned steps now"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Not converged for",
            "desc": true
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "state-timeline",
      "title": "Plan state per datastore",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Converged (green), steps pending (orange) or incomplete plan (red) over time. Only datastores that were not converged at some point in the range are shown, at most 15.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk_max(15, label_join(((max by (kubernetes_namespace, datastore_uuid) (((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"})) == 1) * 2 or ((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) > 0) * 0 + 1 or (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * 0)) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (max by (kubernetes_namespace, datastore_uuid) (((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"})) == 1) * 2 or ((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) > 0) * 0 + 1 or (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"})) * 0)) and on (kubernetes_namespace, datastore_uuid) (max_over_time(((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0) or (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}) > 0))[$__range:1m]) > 0), \"display\", \" / \", \"kubernetes_namespace\", \"DatastoreName\", \"datastore_uuid\"))",
          "legendFormat": "{{display}}",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "converged",
                  "color": "green"
                },
                "1": {
                  "text": "steps pending",
                  "color": "orange"
                },
                "2": {
                  "text": "incomplete plan",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Planned steps per datastore",
      "description": "Steps in the last computed plan of each datastore. Drops by one as each step finishes. Shows the 10 series with the highest peak in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "topk_max(10, ((max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0) * on (datastore_uuid) group_left (DatastoreName, ClusterType) max by (datastore_uuid, DatastoreName, ClusterType) (label_replace(last_over_time(up{job=~\"cmon-sd.*\", environment=~\"$environment\"}[$__range]) * 0 + 1, \"datastore_uuid\", \"$1\", \"ClusterName\", \"(.*)\"))) or on (kubernetes_namespace, datastore_uuid) (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0))",
          "legendFormat": "{{kubernetes_namespace}} / {{DatastoreName}} {{datastore_uuid}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Datastores not converged",
      "description": "Datastores with planned steps and with an incomplete plan, per environment.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (kubernetes_namespace) (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_planned_steps{kubernetes_namespace=~\"$environment\"}) > 0)",
          "legendFormat": "{{kubernetes_namespace}} steps pending",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "count by (kubernetes_namespace) (max by (kubernetes_namespace, datastore_uuid) (ccx_datastores_reconcile_plan_incomplete{kubernetes_namespace=~\"$environment\"}) == 1)",
          "legendFormat": "{{kubernetes_namespace}} incomplete",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      }
    },
    {
      "type": "row",
      "title": "Reconciler activity (logs)",
      "collapsed": false,
      "panels": [],
      "datasource": null,
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "timeseries",
      "title": "Jobs dispatched by type",
      "description": "Jobs the reconciler started (add node, remove node, promote replica, resize disk), from the state-worker logs, per interval.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (kind) (count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |= \"reconcile: dispatched\" | regexp \"reconcile: dispatched (?P<kind>[a-z-]+) job\" [$__auto]))",
          "legendFormat": "{{kind}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "Reconcile pass outcomes",
      "description": "What each reconcile pass ended with, per interval: a step executed, waiting (new nodes, no healthy primary, unhealthy host), incomplete plan, or an error. Converged passes are left out; they are the large majority. \"Waiting\" is a debug line and only appears when the state worker logs at debug level.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |~ \"reconcile( disk only)?: execute step\" [$__auto]))",
          "legendFormat": "step executed",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "B",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |= \"reconcile: waiting\" [$__auto]))",
          "legendFormat": "waiting",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "C",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |= \"reconcile: plan is incomplete\" [$__auto]))",
          "legendFormat": "plan incomplete",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "D",
          "expr": "sum(count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |= \"work function failed\" |~ \"reconcile store\" [$__auto]))",
          "legendFormat": "failed",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m",
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "type": "table",
      "title": "Steps executed per datastore (range)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Reconcile steps started per datastore and kind in the selected range, from the state-worker logs. Look the UUID up in the table above for its name.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (namespace, cluster_uuid, kind) (count_over_time({namespace=~\"$environment\", container=\"state-worker\"} |~ \"reconcile( disk only)?: execute step\" | regexp \"\\\"step\\\":\\\"(?P<kind>[a-z]+ [a-z]+)\" | json cluster_uuid [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "indexByName": {
              "namespace": 0,
              "cluster_uuid": 1,
              "kind": 2,
              "Last *": 3
            },
            "renameByName": {
              "namespace": "Environment",
              "cluster_uuid": "UUID",
              "kind": "Step",
              "Last *": "Steps"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Steps",
            "desc": true
          }
        ]
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "logs",
      "title": "Reconciler log",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Steps, dispatched jobs, waits, incomplete plans and failures of the reconciler. The per-pass \"starting\", \"planning\", \"converged\" and \"nothing to run\" lines are left out.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "{namespace=~\"$environment\", container=\"state-worker\"} |~ \"reconcile( disk only)?: (execute step|dispatched|waiting|plan is incomplete)|work function failed.*reconcile store\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "type": "row",
      "title": "State worker (stores queue)",
      "collapsed": false,
      "panels": [],
      "datasource": null,
      "id": 18,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      }
    },
    {
      "type": "timeseries",
      "title": "Stores worker wakes / min by path",
      "description": "Why the stores worker picked a datastore up: polling, cmon job or host events, CCX jobs or a spec change. A spec change is what starts most reconciles.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (kubernetes_namespace, path) (rate(worker_wakes_total{kubernetes_namespace=~\"$environment\", app=\"ccx-state-worker\", name=\"stores\"}[$__rate_interval])) * 60",
          "legendFormat": "{{kubernetes_namespace}} / {{path}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      }
    },
    {
      "type": "timeseries",
      "title": "Stores queue length",
      "description": "Datastores waiting to be processed by the state worker; a growing line means reconciles are delayed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (kubernetes_namespace) (worker_queue_length{kubernetes_namespace=~\"$environment\", app=\"ccx-state-worker\", name=\"stores\"})",
          "legendFormat": "{{kubernetes_namespace}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
      }
    },
    {
      "type": "timeseries",
      "title": "Stores task duration (avg) and re-visit p90",
      "description": "Average time to process one datastore, and how long until the same datastore is processed again (p90, from the 0.1/1/10/60/600 s buckets, so coarse).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (kubernetes_namespace) (rate(worker_time_seconds_sum{kubernetes_namespace=~\"$environment\", app=\"ccx-state-worker\", name=\"stores\"}[$__rate_interval])) / sum by (kubernetes_namespace) (rate(worker_time_seconds_count{kubernetes_namespace=~\"$environment\", app=\"ccx-state-worker\", name=\"stores\"}[$__rate_interval]))",
          "legendFormat": "{{kubernetes_namespace}} task avg",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (kubernetes_namespace, le) (rate(worker_interval_seconds_bucket{kubernetes_namespace=~\"$environment\", app=\"ccx-state-worker\", name=\"stores\"}[$__rate_interval])))",
          "legendFormat": "{{kubernetes_namespace}} re-visit p90",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 21,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 49
      }
    }
  ]
}
