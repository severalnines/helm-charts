    "ccx",
    "jobs",
    "backups"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ccx"
      ],
      "asDropdown": true,
      "title": "CCX dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "environment",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
        "query": {
          "query": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
          "refId": "StandardVariableQuery"
        },
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "options": []
      },
      {
        "name": "cronjob",
        "label": "CronJob",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_cronjob_info{namespace=~\"$environment\"}, cronjob)",
        "query": {
          "query": "label_values(kube_cronjob_info{namespace=~\"$environment\"}, cronjob)",
          "refId": "StandardVariableQuery"
        },
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "CronJobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "CronJobs",
      "description": "Number of CronJobs in the selected environments.",
      "targets": [
        {
          "expr": "count(kube_cronjob_info{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Active jobs",
      "description": "CronJob-spawned jobs currently running.",
      "targets": [
        {
          "expr": "sum(kube_cronjob_status_active{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Failed jobs (retained)",
      "description": "Jobs in the selected environments (all jobs, not only the selected CronJobs) currently marked failed and still kept in the Kubernetes job history. A retained failure can be weeks old; see \"Failed since last success\" in the CronJob table for current breakage.",
      "targets": [
        {
          "expr": "count(kube_job_status_failed{namespace=~\"$environment\"} > 0) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Suspended CronJobs",
      "description": "CronJobs whose schedule is suspended.",
      "targets": [
        {
          "expr": "sum(kube_cronjob_spec_suspend{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "CronJob status",
      "description": "Per CronJob: schedule, time since last schedule and last success (\"never\" if it never succeeded), active jobs, failed runs that started after the last success (older failures kept in the job history are not counted), and suspension. A success much older than the schedule means it is broken.",
      "targets": [
        {
          "expr": "max by (namespace, cronjob, schedule) (kube_cronjob_info{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "time() - max by (namespace, cronjob) (kube_cronjob_status_last_schedule_time{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "time() - max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        },
        {
          "expr": "max by (namespace, cronjob) (kube_cronjob_status_active{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D"
        },
        {
          "expr": "count by (namespace, cronjob) ((label_replace(max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\"}) > 0), \"cronjob\", \"$1\", \"job_name\", \"(.*)-[0-9]+\") > on (namespace, cronjob) group_left max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\"$cronjob\"})) or (label_replace(max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\"}) > 0), \"cronjob\", \"$1\", \"job_name\", \"(.*)-[0-9]+\") unless on (namespace, cronjob) max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\"$cronjob\"}))) * on (namespace, cronjob) group_left max by (namespace, cronjob) (kube_cronjob_info{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E"
        },
        {
          "expr": "max by (namespace, cronjob) (kube_cronjob_spec_suspend{namespace=~\"$environment\", cronjob=~\"$cronjob\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "namespace": 0,
              "cronjob": 1,
              "schedule": 2
            },
            "renameByName": {
              "namespace": "Environment",
              "cronjob": "CronJob",
              "schedule": "Schedule",
              "Value #B": "Since last schedule",
              "Value #C": "Since last success",
              "Value #D": "Active",
              "Value #E": "Failed since last success",
              "Value #F": "Suspended"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since last schedule"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 3600
                    },
                    {
                      "color": "red",
                      "value": 90000
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed since last success"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suspended"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "green"
                      },
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Failed jobs",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 6,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Time since last successful run",
      "description": "Age of the last successful run per CronJob; a saw-tooth is healthy, a steadily rising line means runs stopped succeeding. Shows the 10 series with the highest peak in the selected time range.",
      "targets": [
        {
          "expr": "topk_max(10, time() - max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\"$cronjob\"}))",
          "legendFormat": "{{namespace}} / {{cronjob}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Active CronJob runs",
      "description": "Running jobs per CronJob over time. Shows the 10 series with the highest peak in the selected time range.",
      "targets": [
        {
          "expr": "topk_max(10, sum by (namespace, cronjob) (kube_cronjob_status_active{namespace=~\"$environment\", cronjob=~\"$cronjob\"}))",
          "legendFormat": "{{namespace}} / {{cronjob}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "id": 9,
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Failed jobs",
      "description": "All jobs currently marked failed and still kept in the Kubernetes job history in the selected environments, with the failure reason and start time. Failed = 1 means the job failed (kube-state-metrics reports a 0/1 flag per reason, not the number of failed pods).",
      "targets": [
        {
          "expr": "max by (namespace, job_name, reason) (kube_job_status_failed{namespace=~\"$environment\"} > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\"}) * 1000 and on (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\"} > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Environment",
              "job_name": "Job",
              "reason": "Reason",
              "Value #A": "Failed",
              "Value #B": "Started"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "CCX hook jobs",
      "description": "Helm hook jobs (ccx-migrate*, ccx-check-certificate*, ccx-create-db-secrets*, ccx-label-cmon-secrets*) with start time and outcome; they only exist briefly after an install or upgrade.",
      "targets": [
        {
          "expr": "max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\", job_name=~\"ccx-migrate.*|ccx-check-certificate.*|ccx-create-db-secrets.*|ccx-label-cmon-secrets.*\"}) * 1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
