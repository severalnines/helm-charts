        {
          "expr": "count by (namespace, cronjob) ((label_replace(max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\", job_name=~\".*s3-backup.*\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\", job_name=~\".*s3-backup.*\"}) > 0), \"cronjob\", \"$1\", \"job_name\", \"(.*)-[0-9]+\") > on (namespace, cronjob) group_left max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\".*s3-backup.*\"})) or (label_replace(max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\", job_name=~\".*s3-backup.*\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\", job_name=~\".*s3-backup.*\"}) > 0), \"cronjob\", \"$1\", \"job_name\", \"(.*)-[0-9]+\") unless on (namespace, cronjob) max by (namespace, cronjob) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=~\".*s3-backup.*\"})))",
