{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "CCX control-plane status per environment: cmon, datastores, CCX pods and deployment health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ccx"
      ],
      "asDropdown": true,
      "title": "CCX dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Container image and tag per container in Running pods of the environment (kube-state-metrics kube_pod_container_info joined with kube_pod_status_phase, so completed CronJob/Job pods with old tags are excluded); Pods = number of running pods with that image. Replaces the old helm_chart_info panel, which is not exported.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Container"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tag"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pods"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 13,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Container",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "count by (container, tag, image) (label_replace(kube_pod_container_info{namespace=~\"$namespace\", exported_cluster=~\"$cluster\"} * on (namespace, pod) group_left () (kube_pod_status_phase{namespace=~\"$namespace\", exported_cluster=~\"$cluster\", phase=\"Running\"} == 1), \"tag\", \"$1\", \"image\", \".*:([^:/@]+)$\"))"
        }
      ],
      "title": "$namespace CCX image versions",
      "transparent": true,
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "container": 0,
              "tag": 1,
              "Value": 2,
              "image": 3
            },
            "renameByName": {
              "container": "Container",
              "tag": "Tag",
              "Value": "Pods",
              "image": "Image"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of cmon controllers reporting cmon_up=1 in the environment; DOWN when none is up or the cmon exporter is not scraped. Counted once per controller/datastore, so a cmon pod restart (old and new series overlapping for one scrape) doesn't double it. Shows no data when no cmon reports in the selection. \"no cmon metrics\" means the cmon exporter is not being scraped (see Exporter scrape failing on CCX / cmon Controller).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "noValue": "no cmon metrics"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 2,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(max by (kubernetes_namespace) (cmon_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"})) or (count(cmon_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) * 0)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CMON UP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Datastores that cmon reports as up (cmon_cluster_up == 1). Counted once per controller/datastore, so a cmon pod restart (old and new series overlapping for one scrape) doesn't double it. Shows no data when no cmon reports in the selection. \"no cmon metrics\" means the cmon exporter is not being scraped (see Exporter scrape failing on CCX / cmon Controller).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "NONE"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "no cmon metrics"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 2,
        "x": 2,
        "y": 8
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(max by (kubernetes_namespace, ClusterName) (cmon_cluster_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) == 1) or (count(cmon_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) * 0)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Datastores UP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Datastores that cmon reports as down (cmon_cluster_up == 0); 0 means all datastores are up. Counted once per controller/datastore, so a cmon pod restart (old and new series overlapping for one scrape) doesn't double it. Shows no data when no cmon reports in the selection. \"no cmon metrics\" means the cmon exporter is not being scraped (see Exporter scrape failing on CCX / cmon Controller).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "noValue": "no cmon metrics"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 2,
        "x": 4,
        "y": 8
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "count(max by (kubernetes_namespace, ClusterName) (cmon_cluster_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) == 0) or (count(cmon_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) * 0)",
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Datastores DOWN",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "CPU used per container in the environment, as % of one core (cAdvisor). Shows the 10 series with the highest peak in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 100,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 9,
        "x": 6,
        "y": 8
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "topk_max(10, sum by (container) (rate(container_cpu_usage_seconds_total{job=~\".*cadvisor.*\", namespace=~\"$namespace\", exported_cluster=~\"$cluster\", container!=\"\", container!=\"POD\", image!=\"\"}[$__rate_interval])) * 100)",
          "instant": false,
          "legendFormat": "{{ container }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container CPU usage %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Working-set memory per container in the environment (cAdvisor). Shows the 10 series with the highest peak in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 29,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 9,
        "x": 15,
        "y": 8
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "topk_max(10, sum by (container) (container_memory_working_set_bytes{job=~\".*cadvisor.*\", namespace=~\"$namespace\", exported_cluster=~\"$cluster\", container!=\"\", container!=\"POD\", image!=\"\"}))",
          "instant": false,
          "legendFormat": "{{ container }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container MEM usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "All datastores managed by cmon in the environment with their status (1 = up, 0 = down).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "index": 0,
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "index": 1,
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "index": 1,
                        "text": "DOWN"
                      },
                      "1": {
                        "index": 0,
                        "text": "UP"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cluster ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Status"
          }
        ]
      },
      "pluginVersion": "9.3.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "cmon_cluster_up{kubernetes_namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Datastores",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "app": true,
              "cluster": true,
              "controller_revision_hash": true,
              "ControllerId": true,
              "exported_cluster": true,
              "instance": true,
              "job": true,
              "kubernetes_namespace": true,
              "kubernetes_pod_name": true,
              "monitor": true,
              "run": true,
              "statefulset_kubernetes_io_pod_name": true,
              "use_cmon_sd": true,
              "apps_kubernetes_io_pod_index": true
            },
            "indexByName": {
              "Status": 0,
              "Name": 1,
              "Cluster ID": 2
            },
            "renameByName": {
              "ClusterID": "Cluster ID",
              "ClusterName": "Name",
              "Value": "Status"
            }
          }
        }
      ],
      "transparent": true,
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Available / desired replicas per deployment (OK = 100%); deployments scaled to 0 are hidden to avoid division by zero.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": true,
              "title": "Show details",
              "url": "d/oWe9aYxmk/kubernetes-deployment-statefulset-daemonset-metrics?orgId=1&refresh=30s&var-Deployment=${__field.labels.deployment}&var-Statefulset=All&var-Daemonset=All&var-Node=All&var-namespace=${__field.labels.namespace}&from=now-24h&to=now"
            },
            {
              "targetBlank": true,
              "title": "Logs",
              "url": "https://console.cloud.google.com/logs/query;query=resource.type%3D%22k8s_container%22%0Aresource.labels.cluster_name%3D%22${__field.labels.cluster}%22%0Aresource.labels.container_name%3D%22${__field.labels.deployment}%22%0Aresource.labels.namespace_name%3D%22${__field.labels.namespace}%22"
            }
          ],
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000,
                "result": {
                  "index": 0,
                  "text": "OK"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.9999,
                "result": {
                  "index": 1,
                  "text": "BAD"
                }
              }
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 17,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 8,
      "links": [],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 18,
          "valueSize": 28
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.3.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) / (sum by (deployment) (kube_deployment_spec_replicas{namespace=~\"$namespace\", exported_cluster=~\"$cluster\"}) > 0)",
          "interval": "",
          "legendFormat": "{{ deployment }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Deployments $namespace",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "style": "dark",
  "tags": [
    "ccx"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
