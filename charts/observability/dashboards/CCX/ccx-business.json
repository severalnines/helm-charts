      "description": "Registered users now minus 24 hours ago, per environment, summed. This is a net change of a gauge, not a signup count: deleted users make it drop and can hide signups. Environments that did not exist 24 hours ago (e.g. CI namespaces) are left out instead of being counted as new users.",
      "targets": [
        {
          "expr": "sum(max by (kubernetes_namespace) (admin_users_total{kubernetes_namespace=~\"$environment\", kind=\"all\"}) - max by (kubernetes_namespace) (admin_users_total{kubernetes_namespace=~\"$environment\", kind=\"all\"} offset 1d))",
          "legendFormat": "__auto",
          "range": false,
