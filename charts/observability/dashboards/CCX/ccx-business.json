    {
      "type": "stat",
      "title": "Users",
      "description": "Registered users (admin_users_total kind=all: rows in the users table; in a production-mode env, severalnines/s9s.io logins are excluded). The gauge is repeated on every rest-admin replica, so it is taken once per environment and summed across selected environments.",
      "targets": [
        {
          "expr": "sum(max by (kubernetes_namespace) (admin_users_total{kubernetes_namespace=~\"$environment\", kind=\"all\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
