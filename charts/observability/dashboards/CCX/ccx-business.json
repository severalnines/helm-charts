    {
      "type": "stat",
      "title": "Billing error % (range)",
      "description": "Share of billing gRPC calls with a code other than OK or NotFound over the selected range (NotFound is a normal lookup miss; Canceled and FailedPrecondition count as errors). 0 when there were calls but no errors; no data when the billing service was not scraped.",
      "targets": [
        {
          "expr": "(sum(increase(grpc_server_handled_total{kubernetes_namespace=~\"$environment\", grpc_service=~\".*[Bb]illing.*\", grpc_code!~\"OK|NotFound\"}[$__range])) or vector(0)) / clamp_min(sum(increase(grpc_server_handled_total{kubernetes_namespace=~\"$environment\", grpc_service=~\".*[Bb]illing.*\"}[$__range])), 1)",
          "legendFormat": "__auto",
          "range": false,
