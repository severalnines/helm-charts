      "description": "Distinct user_id values in the datastores (clusters) table (admin_users_total kind=with-datastores). Backend definition: it includes deleted datastores that are not purged yet and owners whose user account no longer exists, so it can be larger than \"Users\". Taken once per environment (not per replica) and summed.",
      "targets": [
        {
          "expr": "sum(max by (kubernetes_namespace) (admin_users_total{kubernetes_namespace=~\"$environment\", kind=\"with-datastores\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
