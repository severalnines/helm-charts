        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
        "query": {
          "query": "label_values({__name__=~\"cmon_up|requests_total\"}, kubernetes_namespace)",
          "refId": "StandardVariableQuery"
        },
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
