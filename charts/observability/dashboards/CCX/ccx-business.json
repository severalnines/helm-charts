    {
      "type": "table",
      "title": "Billing updater status",
      "description": "Per environment: time since the last successful billing-updater run (schedule is every 10 minutes), time since it was last scheduled, failed runs that started after the last success (old failures kept in the job history are not counted), and whether the CronJob is suspended.",
      "targets": [
        {
          "expr": "time() - max by (namespace) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "time() - max by (namespace) (kube_cronjob_status_last_schedule_time{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        },
        {
          "expr": "count by (namespace) (((max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\", job_name=~\"ccx-billing-updater-[0-9]+\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\", job_name=~\"ccx-billing-updater-[0-9]+\"}) > 0)) > on (namespace) group_left max by (namespace) (kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"})) or ((max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"$environment\", job_name=~\"ccx-billing-updater-[0-9]+\"}) and on (namespace, job_name) (max by (namespace, job_name) (kube_job_status_failed{namespace=~\"$environment\", job_name=~\"ccx-billing-updater-[0-9]+\"}) > 0)) unless on (namespace) kube_cronjob_status_last_successful_time{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"})) or (0 * max by (namespace) (kube_cronjob_info{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C"
        },
        {
          "expr": "max by (namespace) (kube_cronjob_spec_suspend{namespace=~\"$environment\", cronjob=\"ccx-billing-updater\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Environment",
              "Value #A": "Since last success",
              "Value #B": "Since last schedule",
              "Value #C": "Failed since last success",
              "Value #D": "Suspended"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1800
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since last schedule"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed since last success"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suspended"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "green"
                      },
                      "1": {
                        "text": "yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Since last success",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 23,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Billing updater job outcomes",
      "description": "Billing-updater jobs per environment that Kubernetes still keeps in its job history, by outcome (succeeded / failed). The history is capped by the CronJob history limits, so this is a count of retained jobs, not runs per period; a retained failure can be weeks old. Shows the 10 series with the highest peak in the selected time range.",
      "targets": [
        {
          "expr": "topk_max(10, sum by (namespace) (kube_job_status_succeeded{namespace=~\"$environment\", job_name=~\"ccx-billing-updater.*\"}))",
          "legendFormat": "succeeded {{namespace}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "topk_max(10, sum by (namespace) (kube_job_status_failed{namespace=~\"$environment\", job_name=~\"ccx-billing-updater.*\"}))",
          "legendFormat": "failed {{namespace}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "failed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 24,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
