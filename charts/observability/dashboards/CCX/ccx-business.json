    {
      "type": "bargauge",
      "title": "Datastore status breakdown",
      "description": "Current number of datastores per status (created, pending, failed, deleting) across the selected environments. Creating, restoring and deleted-not-purged datastores are only in the total.",
      "targets": [
        {
          "expr": "sum by (status) (max by (kubernetes_namespace, status) (admin_datastores_total{kubernetes_namespace=~\"$environment\", status!=\"all\"}))",
          "legendFormat": "{{status}}",
          "range": false,
