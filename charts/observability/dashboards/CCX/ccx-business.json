    {
      "type": "table",
      "title": "Datastores per environment",
      "description": "Current datastores per environment and status. \"all\" counts every record, including in-progress and deleted-but-not-purged datastores, so it can exceed the sum of the other columns.",
      "targets": [
        {
          "expr": "max by (kubernetes_namespace, status) (admin_datastores_total{kubernetes_namespace=~\"$environment\"})",
