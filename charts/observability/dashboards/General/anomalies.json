{
  "title": "Anomalies",
  "uid": "anomalies-adaptive",
  "id": null,
  "tags": ["anomaly-detection", "victoriametrics"],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "editable": true,
  "style": "dark",
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Metrics",
          "value": "Metrics"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "ds",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$ds"
        },
        "definition": "label_values({anomaly_name=~\".+\"},anomaly_name)",
        "includeAll": false,
        "multi": false,
        "name": "anomaly_name",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({anomaly_name=~\".+\"},anomaly_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$ds"
        },
        "definition": "label_values({anomaly_name=\"$anomaly_name\"},namespace)",
        "includeAll": false,
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({anomaly_name=\"$anomaly_name\"},namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$ds"
        },
        "definition": "label_values({anomaly_name=\"$anomaly_name\", namespace=\"$namespace\"},pod)",
        "includeAll": false,
        "multi": false,
        "name": "pod",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({anomaly_name=\"$anomaly_name\", namespace=\"$namespace\"},pod)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$ds"
        },
        "definition": "label_values(ALERTS{alertname=\"AnomalyDetected\"},alertstate)",
        "includeAll": true,
        "multi": true,
        "name": "alertstate",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(ALERTS{alertname=\"AnomalyDetected\"},alertstate)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "description": "Every metric currently outside its expected anomaly band, cluster-wide. Independent of the job/anomaly_name/instance selectors below.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.3.0",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Value": true,
              "alertgroup": true,
              "alertname": true,
              "alertstate": true,
              "anomaly_select": true,
              "job": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "instance": 2,
              "anomaly_name": 3,
              "anomaly_type": 4,
              "anomaly_strategy": 5,
              "severity": 6,
              "Time": 7
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "ALERTS{alertname=\"AnomalyDetected\", alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active Anomalies",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "description": "Baselines provide upper and lower bands around time series data to identify anomalies. Values that remain outside the bands for significant periods of time will be identified as anomalies.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineStyle": {
              "fill": "solid"
            },
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly_upper_band"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "super-light-blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "custom.fillBelowTo",
                "value": "anomaly_lower_band"
              },
              {
                "id": "custom.lineWidth",
                "value": 0.1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly:adaptive:select"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly_lower_band"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "super-light-blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 0.1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anomalies"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 16
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.axisSoftMin",
                "value": 0
              },
              {
                "id": "custom.axisSoftMax",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "super-light-yellow",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "11.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "anomaly:adaptive:select{anomaly_name=\"$anomaly_name\", namespace=\"$namespace\", pod=\"$pod\"}",
          "legendFormat": "{{anomaly_name}} {{namespace}}/{{pod}}{{instance}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "last_over_time(anomaly:lower_band{anomaly_name=\"$anomaly_name\", anomaly_strategy=\"adaptive\", namespace=\"$namespace\", pod=\"$pod\"}[2m])",
          "hide": false,
          "instant": false,
          "legendFormat": "anomaly_lower_band",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "last_over_time(anomaly:upper_band{anomaly_name=\"$anomaly_name\", anomaly_strategy=\"adaptive\", namespace=\"$namespace\", pod=\"$pod\"}[2m])",
          "hide": false,
          "instant": false,
          "legendFormat": "anomaly_upper_band",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "ALERTS{anomaly_name=\"$anomaly_name\", anomaly_strategy=\"adaptive\", namespace=\"$namespace\", pod=\"$pod\", alertstate=\"firing\", anomaly_select=\"1\"}",
          "hide": false,
          "instant": false,
          "legendFormat": "anomalies",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Baselines",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "description": "History of every AnomalyDetected pending/firing sample, cluster-wide - independent of the anomaly_name/namespace/pod selectors above. Widen the time range picker (top right) to look further back. Sorted newest first; a run of consecutive rows for the same pod is one continuous incident.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pending": {
                        "color": "yellow",
                        "index": 0
                      },
                      "firing": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Time"
          }
        ]
      },
      "pluginVersion": "11.3.0",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Value": true,
              "alertgroup": true,
              "alertname": true,
              "anomaly_select": true,
              "job": true
            },
            "indexByName": {
              "Time": 0,
              "namespace": 1,
              "pod": 2,
              "instance": 3,
              "anomaly_name": 4,
              "alertstate": 5,
              "anomaly_type": 6,
              "anomaly_strategy": 7,
              "severity": 8
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "editorMode": "code",
          "expr": "ALERTS{alertname=\"AnomalyDetected\", alertstate=~\"$alertstate\"}",
          "format": "table",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Anomaly History",
      "type": "table"
    }
  ]
}
