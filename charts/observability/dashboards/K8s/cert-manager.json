{
   "__inputs": [ ],
   "__requires": [ ],
   "description": "Minimal cert-manager overview: certificate readiness, expiry, issuer health and ACME API activity.",
   "editable": true,
   "links": [ ],
   "panels": [
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
         "id": 1,
         "title": "Overview",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "steps": [
                     { "color": "green", "value": 0 },
                     { "color": "red", "value": 1 }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
         "id": 2,
         "options": {
            "reduceOptions": { "calcs": [ "lastNotNull" ] }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  certmanager_certificate_ready_status{condition=\"False\"} == 1\n) OR vector(0)\n"
            }
         ],
         "title": "Certificates Not Ready",
         "type": "stat"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "steps": [
                     { "color": "green", "value": 0 },
                     { "color": "red", "value": 1 }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
         "id": 3,
         "options": {
            "reduceOptions": { "calcs": [ "lastNotNull" ] }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "count(\n  certmanager_certificate_expiration_timestamp_seconds - time() < 86400 * 14\n) OR vector(0)\n"
            }
         ],
         "title": "Expiring Within 14d",
         "type": "stat"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "steps": [
                     { "color": "green", "value": 0 },
                     { "color": "red", "value": 1 }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
         "id": 4,
         "options": {
            "reduceOptions": { "calcs": [ "lastNotNull" ] }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  certmanager_clusterissuer_ready_status{condition=\"False\"} == 1\n) OR vector(0)\n"
            }
         ],
         "title": "ClusterIssuers Not Ready",
         "type": "stat"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "steps": [
                     { "color": "green", "value": 0 },
                     { "color": "yellow", "value": 0.01 },
                     { "color": "red", "value": 0.05 }
                  ]
               },
               "unit": "percentunit"
            }
         },
         "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
         "id": 5,
         "options": {
            "reduceOptions": { "calcs": [ "lastNotNull" ] }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  rate(\n    certmanager_http_acme_client_request_count{status!~\"2..\"}[$__rate_interval]\n  )\n)\n/\nsum(\n  rate(\n    certmanager_http_acme_client_request_count[$__rate_interval]\n  )\n)\n"
            }
         ],
         "title": "ACME Error Rate",
         "type": "stat"
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
         "id": 6,
         "title": "Certificates",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": { "unit": "s" },
            "overrides": [
               {
                  "matcher": { "id": "byName", "options": "TTL" },
                  "properties": [
                     {
                        "id": "custom.cellOptions",
                        "value": { "type": "color-text" }
                     },
                     {
                        "id": "thresholds",
                        "value": {
                           "mode": "absolute",
                           "steps": [
                              { "color": "red", "value": 0 },
                              { "color": "yellow", "value": 604800 },
                              { "color": "green", "value": 1209600 }
                           ]
                        }
                     }
                  ]
               }
            ]
         },
         "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
         "id": 7,
         "options": {
            "footer": { "enablePagination": true },
            "sortBy": [
               { "desc": false, "displayName": "TTL" }
            ]
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "avg(\n  certmanager_certificate_expiration_timestamp_seconds\n) by (name, namespace, issuer_name) - time()\n",
               "format": "table",
               "instant": true
            }
         ],
         "title": "Certificate Expiry",
         "transformations": [
            {
               "id": "organize",
               "options": {
                  "excludeByName": { "Time": true },
                  "indexByName": { "namespace": 0, "name": 1, "issuer_name": 2, "Value": 3 },
                  "renameByName": {
                     "namespace": "Namespace",
                     "name": "Name",
                     "issuer_name": "Issuer",
                     "Value": "TTL"
                  }
               }
            }
         ],
         "type": "table"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "lineInterpolation": "stepAfter",
                  "spanNulls": false
               },
               "max": 1,
               "min": 0,
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
         "id": 8,
         "options": {
            "legend": {
               "calcs": [ ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true
            },
            "tooltip": { "mode": "multi", "sort": "desc" }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  certmanager_certificate_ready_status{condition=\"True\"}\n) by (namespace, name)\n",
               "legendFormat": "{{ namespace }}/{{ name }}"
            }
         ],
         "title": "Certificate Readiness (1 = ready)",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
         "id": 9,
         "title": "Issuers & Controller",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": [
               {
                  "matcher": { "id": "byName", "options": "Ready" },
                  "properties": [
                     {
                        "id": "custom.cellOptions",
                        "value": { "type": "color-text" }
                     },
                     {
                        "id": "thresholds",
                        "value": {
                           "mode": "absolute",
                           "steps": [
                              { "color": "red", "value": 0 },
                              { "color": "green", "value": 1 }
                           ]
                        }
                     }
                  ]
               }
            ]
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
         "id": 10,
         "options": {
            "footer": { "enablePagination": false },
            "sortBy": [ ]
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "certmanager_clusterissuer_ready_status{condition=\"True\"}",
               "format": "table",
               "instant": true
            }
         ],
         "title": "ClusterIssuer Status",
         "transformations": [
            {
               "id": "organize",
               "options": {
                  "excludeByName": { "Time": true, "condition": true },
                  "indexByName": { "name": 0, "Value": 1 },
                  "renameByName": { "name": "Issuer", "Value": "Ready" }
               }
            }
         ],
         "type": "table"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "custom": { "spanNulls": false },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
         "id": 11,
         "options": {
            "legend": {
               "calcs": [ "mean", "max" ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true
            },
            "tooltip": { "mode": "multi", "sort": "desc" }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  rate(\n    certmanager_controller_sync_call_count[$__rate_interval]\n  )\n) by (controller)\n",
               "legendFormat": "{{ controller }}"
            }
         ],
         "title": "Controller Sync Activity",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
         "id": 12,
         "title": "ACME API",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 20,
                  "spanNulls": false
               },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
         "id": 13,
         "options": {
            "legend": {
               "calcs": [ "mean", "max" ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true
            },
            "tooltip": { "mode": "multi", "sort": "desc" }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  rate(\n    certmanager_http_acme_client_request_count[$__rate_interval]\n  )\n) by (status)\n",
               "legendFormat": "status {{ status }}"
            }
         ],
         "title": "ACME Request Rate by Status",
         "type": "timeseries"
      },
      {
         "datasource": { "type": "prometheus", "uid": "$datasource" },
         "fieldConfig": {
            "defaults": {
               "custom": { "spanNulls": false },
               "unit": "s"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
         "id": 14,
         "options": {
            "legend": {
               "calcs": [ "mean", "max" ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true
            },
            "tooltip": { "mode": "multi", "sort": "desc" }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "$datasource" },
               "expr": "sum(\n  rate(\n    certmanager_http_acme_client_request_duration_seconds_sum[$__rate_interval]\n  )\n) by (action)\n/\nsum(\n  rate(\n    certmanager_http_acme_client_request_duration_seconds_count[$__rate_interval]\n  )\n) by (action)\n",
               "legendFormat": "{{ action }}"
            }
         ],
         "title": "ACME Avg Request Latency by Action",
         "type": "timeseries"
      }
   ],
   "schemaVersion": 39,
   "tags": [ "k8s", "cert-manager" ],
   "templating": {
      "list": [
         {
            "current": { "selected": true, "text": "default", "value": "default" },
            "label": "Data source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "utc",
   "title": "cert-manager",
   "uid": "u6M5igpWk"
}
