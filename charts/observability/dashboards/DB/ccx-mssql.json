{
  "uid": "ccx-mssql",
  "title": "CCX / SQL Server",
  "description": "CCX Microsoft SQL Server datastores (single and Always On) discovered via cmon service discovery.",
  "tags": [
    "ccx",
    "datastores",
    "mssql"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ccx"
      ],
      "asDropdown": true,
      "title": "CCX dashboards",
      "includeVars": true,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Node Exporter",
      "icon": "dashboard",
      "url": "/d/rYdddlPWk/node-exporter-full",
      "keepTime": true,
      "tooltip": "Host metrics (pick the node there, or click a series here)"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "environment",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "query_result(count by (ns) (label_replace({__name__=~\"cmon_up|requests_total\"}, \"ns\", \"$1\", \"kubernetes_namespace\", \"(.+)\")) or count by (ns) (label_replace(mssql_up{job=~\"cmon-sd.*\"}, \"ns\", \"$1\", \"environment\", \"(.+)\")))",
        "query": "query_result(count by (ns) (label_replace({__name__=~\"cmon_up|requests_total\"}, \"ns\", \"$1\", \"kubernetes_namespace\", \"(.+)\")) or count by (ns) (label_replace(mssql_up{job=~\"cmon-sd.*\"}, \"ns\", \"$1\", \"environment\", \"(.+)\")))",
        "current": {},
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "regex": "/ns=\"([^\"]+)\"/",
        "options": [],
        "hide": 0
      },
      {
        "name": "datastore",
        "label": "Datastore",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "description": "Pick by datastore name; the value used in queries is the CCX datastore UUID (ClusterName).",
        "definition": "query_result(count by (ClusterName, DatastoreName) (mssql_up{job=~\"cmon-sd.*\",environment=~\"$environment\"}))",
        "query": "query_result(count by (ClusterName, DatastoreName) (mssql_up{job=~\"cmon-sd.*\",environment=~\"$environment\"}))",
        "regex": "/ClusterName=\"(?<value>[^\"]+)\".*DatastoreName=\"(?<text>[^\"]*)\"/",
        "current": {},
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 5,
        "options": [],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(mssql_up{job=~\"cmon-sd.*\",environment=~\"$environment\",ClusterName=~\"$datastore\"}, instance)",
        "query": "label_values(mssql_up{job=~\"cmon-sd.*\",environment=~\"$environment\",ClusterName=~\"$datastore\"}, instance)",
        "current": {},
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Nodes",
      "description": "One row per SQL Server node: exporter status, CCX cluster type, user connections and page life expectancy; click the IP for host metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (DatastoreName, instance, ip, job, ClusterType) (mssql_up{job=~\"cmon-sd.*\",environment=~\"$environment\",ClusterName=~\"$datastore\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (DatastoreName, instance, ip, job, ClusterType) (mssql_userconnections{job=~\"cmon-sd.*\",environment=~\"$environment\",ClusterName=~\"$datastore\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (DatastoreName, instance, ip, job, ClusterType) (mssql_PLE{job=~\"cmon-sd.*\",environment=~\"$environment\",ClusterName=~\"$datastore\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Page life expectancy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IP"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Node metrics for ${__data.fields.ip}",
                    "url": "/d/rYdddlPWk/node-exporter-full?var-datasource=${datasource}&var-job=${__data.fields.job}&var-node=${__data.fields.ip}:9100&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Datastore",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "renameByName": {
              "DatastoreName": "Datastore",
              "ClusterType": "Type",
              "ip": "IP",
              "instance": "Instance",
              "Value #A": "Status",
              "Value #B": "User connections",
              "Value #C": "Page life expectancy"
            },
            "indexByName": {}
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
