      "type": "stat",
      "title": "Total Locks",
      "gridPos": {
        "x": 14,
        "y": 32,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
