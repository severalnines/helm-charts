      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=~\"$datname\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=~\"$datname\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"$job\", datname=~\"$datname\"}[5m])))",
          "legendFormat": "Cache Hit %"
        }
      ]
    },
    {
      "id": 32,
