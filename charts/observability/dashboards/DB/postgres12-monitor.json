    {
      "id": 43,
      "type": "stat",
      "title": "Exclusive Locks",
      "gridPos": {
        "x": 14,
        "y": 36,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
