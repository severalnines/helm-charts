      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_inserted{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Inserts/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Updates/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Deletes/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_fetched{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Fetches/s"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Deadlocks & Conflicts",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Deadlocks/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_conflicts{job=\"$job\", datname=~\"$datname\"}[5m]))",
          "legendFormat": "Conflicts/s"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Cache & I/O",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
