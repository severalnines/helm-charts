{
  "title": "ccx-db-monitoring",
  "uid": "postgres12-monitor",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "ccx",
    "postgres",
    "postgresql"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "options": [],
        "regex": "",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(pg_up, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "hide": 0,
        "definition": "label_values(pg_up, job)",
        "current": {},
        "options": [],
        "description": "postgres_exporter scrape job of the database to show."
      },
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(pg_stat_database_numbackends{job=~\"$job\", datname!~\"template.*\"}, datname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "hide": 0,
        "definition": "label_values(pg_stat_database_numbackends{job=~\"$job\", datname!~\"template.*\"}, datname)",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "description": "Database(s) to include in the per-database panels (template databases are always excluded)."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "min(pg_up{job=~\"$job\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "1 when every postgres_exporter target of the job can reach PostgreSQL (min of pg_up)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "Backends connected to the selected databases (pg_stat_database_numbackends, all states including idle), summed over all instances of the job."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Database Size",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(max by (ClusterName, datname) (pg_database_size_bytes{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "Total on-disk size of the selected databases. Replicas hold a full copy, so each database is counted once (largest node value per database and ClusterName), not summed across nodes."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "yellow"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "sum(increase(pg_stat_database_blks_hit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__range])) / (sum(increase(pg_stat_database_blks_hit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__range])) + sum(increase(pg_stat_database_blks_read{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__range])) > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "Share of block reads served from shared buffers over the selected time range (increase of blks_hit / (blks_hit + blks_read)), selected databases. No value when there were no block reads in the range."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Transactions/sec",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval])) + sum(rate(pg_stat_database_xact_rollback{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "Commits plus rollbacks per second in the selected databases."
    },
    {
      "id": 10,
      "type": "row",
      "title": "Connections",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connections by Database",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (datname) (pg_stat_database_numbackends{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"})",
          "legendFormat": "{{datname}}"
        }
      ],
      "description": "Connected backends per database."
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Connection Utilization",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * max(sum by (instance) (pg_stat_database_numbackends{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}) / clamp_min(max by (instance) (pg_settings_max_connections{job=~\"$job\"}), 1))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "description": "Connections to the selected databases as % of max_connections on the busiest instance."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Max Connections Limit",
      "gridPos": {
        "x": 19,
        "y": 5,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"})",
          "legendFormat": "Used"
        },
        {
          "expr": "sum(pg_settings_max_connections{job=~\"$job\"})",
          "legendFormat": "Max"
        }
      ],
      "description": "Connections to the selected databases versus the configured max_connections, both summed over all instances of the job."
    },
    {
      "id": 20,
      "type": "row",
      "title": "Transactions & Throughput",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Transaction Rate",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Rollbacks/s"
        }
      ],
      "description": "Committed and rolled-back transactions per second in the selected databases."
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Tuple Operations Rate",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_inserted{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Inserts/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Updates/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Deletes/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_fetched{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Fetches/s"
        }
      ],
      "description": "Rows inserted, updated, deleted and fetched per second in the selected databases."
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Deadlocks & Conflicts",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Deadlocks/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_conflicts{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Conflicts/s"
        }
      ],
      "description": "Deadlocks and recovery conflicts (cancelled queries on replicas) per second in the selected databases."
    },
    {
      "id": 30,
      "type": "row",
      "title": "Cache & I/O",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Cache Hit Ratio",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.9,
                "color": "yellow"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "Cache Hit %"
        }
      ],
      "description": "Share of block reads served from shared buffers over the interval, for the selected databases; gaps mean no block reads in the interval."
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Block I/O Rate",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Blocks Hit/s"
        },
        {
          "expr": "sum(rate(pg_stat_database_blks_read{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Blocks Read/s (disk)"
        }
      ],
      "description": "Blocks found in shared buffers versus blocks read from disk/OS cache per second."
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Temp Files Usage",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_temp_bytes{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "Temp Bytes/s"
        }
      ],
      "description": "Bytes per second written to temporary files by queries (sorts/hashes exceeding work_mem)."
    },
    {
      "id": 40,
      "type": "row",
      "title": "Locks",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Locks by Mode",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 19,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (mode) (pg_locks_count{job=~\"$job\", datname=~\"$datname\", datname!~\"template.*\"})",
          "legendFormat": "{{mode}}"
        }
      ],
      "description": "Locks currently held or awaited, by lock mode, in the selected databases."
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Total Locks",
      "gridPos": {
        "x": 19,
        "y": 32,
        "w": 5,
        "h": 4
      },
