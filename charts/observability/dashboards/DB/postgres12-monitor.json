    {
      "id": 51,
      "type": "timeseries",
      "title": "Checkpoint Activity",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_bgwriter_checkpoints_timed_total{job=~\"$job\"}[$__rate_interval])) or sum(rate(pg_stat_checkpointer_num_timed_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "Timed/s"
        },
        {
          "expr": "sum(rate(pg_stat_bgwriter_checkpoints_req_total{job=~\"$job\"}[$__rate_interval])) or sum(rate(pg_stat_checkpointer_num_requested_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "Requested/s"
        }
      ],
      "description": "Scheduled (timed) vs requested checkpoints per second; reads pg_stat_bgwriter_* (PG<=16) or pg_stat_checkpointer_* (PG17+, needs the exporter's stat_checkpointer collector). Empty when the exporter exposes neither, as on the current live install."
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "Buffers Written Rate",
      "gridPos": {
        "x": 8,
        "y": 41,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_bgwriter_buffers_checkpoint_total{job=~\"$job\"}[$__rate_interval])) or sum(rate(pg_stat_checkpointer_buffers_written_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "Checkpoint"
        },
        {
          "expr": "sum(rate(pg_stat_bgwriter_buffers_clean_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "BGWriter"
        },
        {
          "expr": "sum(rate(pg_stat_bgwriter_buffers_backend_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "Backend (direct)"
        },
        {
          "expr": "sum(rate(pg_stat_bgwriter_buffers_alloc_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "Allocated"
        }
      ],
      "description": "Buffers written by checkpoints, the background writer and backends, plus buffers allocated. Checkpoint buffers fall back to pg_stat_checkpointer_*; 'Backend (direct)' does not exist on PG17+ (moved to pg_stat_io)."
    },
