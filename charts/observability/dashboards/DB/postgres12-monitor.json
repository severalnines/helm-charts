    {
      "id": 44,
      "type": "timeseries",
      "title": "Lock Wait Rate (Deadlocks as Proxy)",
      "gridPos": {
        "x": 19,
        "y": 32,
        "w": 5,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          },
          "color": {
            "fixedColor": "red",
